# Supabase (Project: fresher-party-scanner)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Scanner Volunteer Password (Security Update #9)
SCANNER_PASSWORD=fresher2026

# Brevo Email (50/hour, 300/day provider limit; app enforces 40/hr and 280/day)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_API_KEY_2=optional-backup-key-here
BREVO_SENDER_EMAIL=noreply@fresherparty.com
BREVO_SENDER_NAME=Fresher Party 2026

# AI Validation (Gemini primary, Grok backup)
GEMINI_API_KEY=your-gemini-api-key-here
GROK_API_KEY=your-grok-api-key-here

# Auth (Admin sessions expire after 1 hour, Scanner after 8 hours)
JWT_SECRET=your-random-secret-at-least-32-characters-long

# PM Emails (comma-separated, no spaces - PM actions are excluded from audit logs)
PM_EMAILS=pm@fresherparty.com,backup@fresherparty.com

# Cron Job Secret (for Vercel Cron or 60-second queue worker)
CRON_SECRET=your-secure-cron-secret-here

# App URL (for invite and onboarding links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
